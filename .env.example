# Pixel Agents Environment Variables
# Copy this file to .env and uncomment variables as needed.
# .env is gitignored and loaded automatically by the F5 launch config.

# Enable verbose debug logging for hook events (SessionStart, SessionEnd, Stop, etc.)
PIXEL_AGENTS_DEBUG=1

# Districts (v4 Phase 5 Lane C, T7/D-35 "districts = projects"): path to a
# per-project .planning/STATE.md-shaped file, read by GET /api/districts.
# Unset = that district renders honestly as unknown state (no fake numbers).
# WAR_ROOM_DISTRICT_WARROOM_STATE=/path/to/war-room/.planning/v4/STATE-v4.md
# WAR_ROOM_DISTRICT_TWE_STATE=/path/to/two-wheel-events/.planning/STATE.md
